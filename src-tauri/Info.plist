<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated macOS Info.plist by Tauri at bundle time.

  Points the bundle at the compiled asset catalog (Assets.car, shipped via
  bundle.resources) so Finder/IconServices use the modern icon path instead of
  the legacy loose icns. Without CFBundleIconName, Finder draws a stale/inset
  ("smaller") icon while the Dock looks correct. See scripts/make-macos-appicon.sh.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
</dict>
</plist>
